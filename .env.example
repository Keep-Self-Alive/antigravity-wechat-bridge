# ==============================================================================
# Antigravity WeChat Bridge Configuration Template
# ==============================================================================

# [Required] Tencent WeChat Official iLink AI Bot Credentials
# Format: bot_id:bot_token (Obtained from WeChat AI Bot Admin Platform)
WECHAT_BOT_TOKEN=your_bot_id@im.bot:your_secret_token_here
WECHAT_BOT_ID=your_bot_id@im.bot

# [Security] Whitelist of Allowed WeChat User IDs (Leave empty to allow all)
WECHAT_ALLOWED_USER=your_user_id@im.wechat

# [Network] Base Tencent Gateway API Endpoint
WECHAT_BASE_URL=https://ilinkai.weixin.qq.com

# [Local Gateway] Port for Singleton Mutex Lock
PORT=53199

# [System] Prevent Windows Sleep while Daemon is Active
PREVENT_SLEEP=true

# [Media] Max Inbound/Outbound Upload Stream Limit (Bytes, default 100MB)
MAX_UPLOAD_BYTES=104857600
